[Unit]
Description=KOOS subset input watcher
After=network.target koos-back.service

[Service]
Type=simple
User=__USER__
WorkingDirectory=__APP_DIR__
ExecStart=__APP_DIR__/koos-back --config __APP_DIR__/config/koos-back.json subset-watch
Restart=on-failure
RestartSec=5
UMask=0022

[Install]
WantedBy=multi-user.target
